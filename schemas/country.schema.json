{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.riyo.me/schemas/open-datasets/country.schema.json",
  "title": "Country dataset item",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "category",
    "country_code",
    "currency",
    "tax_notes",
    "payout_platforms",
    "developer_platform_notes",
    "tags",
    "sources",
    "last_checked",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "currency": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "tax_notes": { "type": "string" },
    "payout_platforms": { "$ref": "#/definitions/stringList" },
    "developer_platform_notes": { "type": "string" },
    "tags": { "$ref": "#/definitions/tags" },
    "sources": { "$ref": "#/definitions/sources" },
    "last_checked": { "$ref": "#/definitions/date" },
    "notes": { "type": "string" }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "sources": { "type": "array", "items": { "$ref": "#/definitions/source" }, "minItems": 1 },
    "source": {
      "type": "object",
      "required": ["title", "url", "type", "last_checked"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "type": { "type": "string", "enum": ["official", "community", "reference", "unknown"] },
        "last_checked": { "$ref": "#/definitions/date" }
      }
    }
  }
}
