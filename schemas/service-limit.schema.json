{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.riyo.me/schemas/open-datasets/service-limit.schema.json",
  "title": "Developer service limit record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "service", "status", "last_checked", "confidence", "sources"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "service": { "type": "string", "minLength": 1 },
    "provider": { "type": ["string", "null"] },
    "plan": { "type": ["string", "null"] },
    "status": { "enum": ["current", "deprecated", "historical", "needs_verification"] },
    "free_tier": { "type": ["boolean", "null"] },
    "limits": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "value": { "type": ["string", "number", "boolean", "null"] },
          "unit": { "type": ["string", "null"] },
          "notes": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" },
    "first_seen": { "$ref": "#/definitions/dateTime" },
    "last_seen": { "$ref": "#/definitions/dateTime" },
    "last_checked": { "$ref": "#/definitions/dateTime" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sources": { "$ref": "#/definitions/sources" }
  },
  "definitions": {
    "dateTime": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["url", "type"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "type": { "enum": ["official", "database", "research", "news", "community"] },
        "title": { "type": "string" },
        "published_at": { "$ref": "#/definitions/dateTime" }
      }
    }
  }
}
