{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.riyo.me/schemas/ransomware-incident.schema.json",
  "title": "Ransomware incident record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "status", "claim_status", "last_checked", "confidence", "sources"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "victim": { "type": "string" },
    "group": { "type": ["string", "null"] },
    "country": { "type": ["string", "null"] },
    "industry": { "type": ["string", "null"] },
    "summary": { "type": "string" },
    "status": { "enum": ["active", "resolved", "historical", "disputed", "needs_verification"] },
    "claim_status": { "enum": ["actor_claim_only", "victim_confirmed", "independently_confirmed", "disputed", "unknown"] },
    "incident_date": { "type": ["string", "null"], "format": "date" },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "last_checked": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sources": { "$ref": "#/$defs/sources" }
  },
  "$defs": {
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["url", "type"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "type": { "enum": ["official", "database", "research", "news", "community"] },
        "title": { "type": "string" },
        "published_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
