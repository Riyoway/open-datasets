{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.riyo.me/schemas/eol-product.schema.json",
  "title": "Product lifecycle record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "product", "version", "status", "last_checked", "confidence", "sources"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "product": { "type": "string", "minLength": 1 },
    "vendor": { "type": ["string", "null"] },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["current", "maintenance", "security_only", "eol", "upcoming", "unknown"] },
    "release_date": { "type": ["string", "null"], "format": "date" },
    "standard_support_end": { "type": ["string", "null"], "format": "date" },
    "security_support_end": { "type": ["string", "null"], "format": "date" },
    "eol_date": { "type": ["string", "null"], "format": "date" },
    "notes": { "type": "string" },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "last_checked": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sources": { "$ref": "#/$defs/sources" }
  },
  "$defs": {
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["url", "type"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "type": { "enum": ["official", "database", "research", "news", "community"] },
        "title": { "type": "string" },
        "published_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
