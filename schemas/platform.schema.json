{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.riyo.me/schemas/open-datasets/platform.schema.json",
  "title": "Platform dataset item",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "category",
    "website",
    "tags",
    "features",
    "limits",
    "sources",
    "last_checked",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "website": { "type": "string", "pattern": "^https?://" },
    "tags": { "$ref": "#/definitions/tags" },
    "features": {
      "type": "object",
      "required": [
        "paid_products",
        "free_products",
        "adult_content",
        "license_keys",
        "payouts",
        "api_available"
      ],
      "additionalProperties": { "$ref": "#/definitions/status" },
      "properties": {
        "paid_products": { "$ref": "#/definitions/status" },
        "free_products": { "$ref": "#/definitions/status" },
        "adult_content": { "$ref": "#/definitions/status" },
        "license_keys": { "$ref": "#/definitions/status" },
        "payouts": { "$ref": "#/definitions/status" },
        "api_available": { "$ref": "#/definitions/status" }
      }
    },
    "limits": {
      "type": "object",
      "required": ["file_size", "release_count"],
      "additionalProperties": { "$ref": "#/definitions/status" },
      "properties": {
        "file_size": { "$ref": "#/definitions/status" },
        "release_count": { "$ref": "#/definitions/status" }
      }
    },
    "sources": { "$ref": "#/definitions/sources" },
    "last_checked": { "$ref": "#/definitions/date" },
    "notes": { "type": "string" }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": {
      "type": "string",
      "enum": ["yes", "no", "partial", "varies", "unknown", "needs_verification"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/definitions/source" },
      "minItems": 1
    },
    "source": {
      "type": "object",
      "required": ["title", "url", "type", "last_checked"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "type": { "type": "string", "enum": ["official", "community", "reference", "unknown"] },
        "last_checked": { "$ref": "#/definitions/date" }
      }
    }
  }
}
