{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.riyo.me/schemas/open-datasets/ransomware-incident.schema.json",
  "title": "Ransomware incident record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "status", "claim_status", "last_checked", "confidence", "sources"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "victim": { "type": "string" },
    "group": { "type": ["string", "null"] },
    "country": { "type": ["string", "null"] },
    "industry": { "type": ["string", "null"] },
    "summary": { "type": "string" },
    "status": { "enum": ["active", "resolved", "historical", "disputed", "needs_verification"] },
    "claim_status": { "enum": ["actor_claim_only", "victim_confirmed", "independently_confirmed", "disputed", "unknown"] },
    "incident_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "first_seen": { "$ref": "#/definitions/dateTime" },
    "last_seen": { "$ref": "#/definitions/dateTime" },
    "last_checked": { "$ref": "#/definitions/dateTime" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sources": { "$ref": "#/definitions/sources" }
  },
  "definitions": {
    "dateTime": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["url", "type"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "type": { "enum": ["official", "database", "research", "news", "community"] },
        "title": { "type": "string" },
        "published_at": { "$ref": "#/definitions/dateTime" }
      }
    }
  }
}
