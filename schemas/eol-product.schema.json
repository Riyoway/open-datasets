{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.riyo.me/schemas/open-datasets/eol-product.schema.json",
  "title": "Product lifecycle record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "product", "version", "status", "last_checked", "confidence", "sources"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "product": { "type": "string", "minLength": 1 },
    "vendor": { "type": ["string", "null"] },
    "version": { "type": "string", "minLength": 1 },
    "status": { "enum": ["current", "maintenance", "security_only", "eol", "upcoming", "unknown"] },
    "release_date": { "$ref": "#/definitions/nullableDate" },
    "standard_support_end": { "$ref": "#/definitions/nullableDate" },
    "security_support_end": { "$ref": "#/definitions/nullableDate" },
    "eol_date": { "$ref": "#/definitions/nullableDate" },
    "notes": { "type": "string" },
    "first_seen": { "$ref": "#/definitions/dateTime" },
    "last_seen": { "$ref": "#/definitions/dateTime" },
    "last_checked": { "$ref": "#/definitions/dateTime" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sources": { "$ref": "#/definitions/sources" }
  },
  "definitions": {
    "dateTime": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "nullableDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["url", "type"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "type": { "enum": ["official", "database", "research", "news", "community"] },
        "title": { "type": "string" },
        "published_at": { "$ref": "#/definitions/dateTime" }
      }
    }
  }
}
