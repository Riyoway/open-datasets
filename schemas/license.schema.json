{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://api.riyo.me/schemas/open-datasets/license.schema.json",
  "title": "License dataset item",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "category",
    "spdx_id",
    "license_family",
    "commercial_use",
    "modification",
    "distribution",
    "patent_grant",
    "tags",
    "sources",
    "last_checked",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/definitions/id" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "spdx_id": { "type": "string", "minLength": 1 },
    "license_family": { "type": "string", "minLength": 1 },
    "commercial_use": { "$ref": "#/definitions/status" },
    "modification": { "$ref": "#/definitions/status" },
    "distribution": { "$ref": "#/definitions/status" },
    "patent_grant": { "$ref": "#/definitions/status" },
    "tags": { "$ref": "#/definitions/tags" },
    "sources": { "$ref": "#/definitions/sources" },
    "last_checked": { "$ref": "#/definitions/date" },
    "notes": { "type": "string" }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "type": "string", "enum": ["yes", "no", "partial", "varies", "unknown", "needs_verification"] },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "sources": { "type": "array", "items": { "$ref": "#/definitions/source" }, "minItems": 1 },
    "source": {
      "type": "object",
      "required": ["title", "url", "type", "last_checked"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "type": { "type": "string", "enum": ["official", "community", "reference", "unknown"] },
        "last_checked": { "$ref": "#/definitions/date" }
      }
    }
  }
}
